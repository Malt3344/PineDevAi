# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings → API → Project API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string for Drizzle — use the "Transaction pooler" string from Project Settings → Database → Connection string (works from serverless functions; the direct connection string does not)
DATABASE_URL=

# Anthropic API key, used server-side to call Claude directly for the
# premium models and the Pine Script review pass (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenRouter API key, used for the economy models (openrouter.ai/keys).
# Required whenever a conversation uses an "openrouter" model in
# lib/agent/models.ts, which includes the default model.
OPENROUTER_API_KEY=

# The public URL this app is served from (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key, test mode is fine to start (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=

# The Price id for the paid plan (dashboard.stripe.com → Product catalog → your product → pricing)
STRIPE_PRICE_ID=
