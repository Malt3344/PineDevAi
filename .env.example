# Auth.js session secret — generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client, for "Continue with Google" (console.cloud.google.com
# → APIs & Services → Credentials). Authorized redirect URI:
# {NEXT_PUBLIC_SITE_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres connection string for Drizzle — if hosting on Supabase, use the "Transaction pooler" string from Project Settings → Database → Connection string (works from serverless functions; the direct connection string does not)
DATABASE_URL=

# Anthropic API key, used server-side to call Claude directly for the
# premium models and the Pine Script review pass (console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenRouter API key, used for the economy models (openrouter.ai/keys).
# Required whenever a chat uses an "openrouter" model in
# lib/agent/models.ts, which includes the default model.
OPENROUTER_API_KEY=

# The public URL this app is served from (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe secret key, test mode is fine to start (dashboard.stripe.com → Developers → API keys)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=

# The Price id for the paid plan (dashboard.stripe.com → Product catalog → your product → pricing)
STRIPE_PRICE_ID=
